SELECT
  SUM(type = 'lost')          AS total_lost,
  SUM(type = 'found')         AS total_found,
  SUM(status = 'matched')     AS total_matched,
  SUM(status = 'active')      AS total_active
FROM items;


--  SECTION 11 — VIEWS 
 
-- View : Active unresolved items with reporter name
CREATE OR REPLACE VIEW vw_active_items AS
SELECT
  i.item_id,
  i.title,
  i.type,
  i.category,
  i.location,
  i.status,
  u.full_name  AS reported_by,
  i.reported_at
FROM items i
INNER JOIN users u ON i.user_id = u.user_id
WHERE i.status = 'active';
 
-- Use the view
SELECT * FROM vw_active_items WHERE type = 'lost';
 

