CREATE DATABASE unifind_db;
USE unifind_db;
--  UniFind — Complete Database Script
--  Covers: DDL, DML, DQL, Normalization, Keys, Joins,
--          Group By,Having, Stored Procedure, Transactions, Subqueries

--  1. TABLE FORMATION + DDL   2. NORMALIZATION — 3NF is maintained  
DROP TABLE IF EXISTS item_status_log;
DROP TABLE IF EXISTS notifications;
DROP TABLE IF EXISTS comments;
DROP TABLE IF EXISTS cctv_requests;
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS categories;
DROP TABLE IF EXISTS users;


CREATE TABLE categories (
  category_id   INT AUTO_INCREMENT PRIMARY KEY,   -- PK
  name          VARCHAR(60) NOT NULL UNIQUE        -- Candidate Key
);

-- ── USERS 
CREATE TABLE users (
  user_id       INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  full_name     VARCHAR(100) NOT NULL,
  email         VARCHAR(150) NOT NULL UNIQUE,      -- Candidate Key
  password_hash VARCHAR(255) NOT NULL,
  phone         VARCHAR(20),
  role ENUM('student','staff','clerk','admin') DEFAULT 'student',
  created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ── ITEMS 
CREATE TABLE items (
  item_id       INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  user_id       INT,                               -- FK → users
  category_id   INT,                               -- FK → categories (3NF)
  title         VARCHAR(255) NOT NULL,
  description   TEXT,
  image_url     TEXT,
  location      VARCHAR(255),
  type          ENUM('lost','found') NOT NULL,
  status ENUM('active','matched','resolved') DEFAULT 'active',
  reported_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id)     REFERENCES users(user_id)           ON DELETE CASCADE,
  FOREIGN KEY (category_id) REFERENCES categories(category_id)  ON DELETE SET NULL
);

-- ── COMMENTS 
CREATE TABLE comments (
  comment_id    INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  item_id       INT,                               -- FK → items
  user_id       INT,                               -- FK → users (nullable = guest)
  comment_text  TEXT NOT NULL,
  created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (item_id) REFERENCES items(item_id) ON DELETE CASCADE,
  FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL
);

-- ── CCTV REQUESTS 
CREATE TABLE cctv_requests (
  request_id    INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  requester_id  INT,                               -- FK → users
  item_id       INT,                               -- FK → items
  incident_date DATE,
  incident_time TIME,
  location      VARCHAR(255),
  reason        TEXT,
  status ENUM('pending','approved','rejected','completed') DEFAULT 'pending',
  admin_note    TEXT,
  created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY (requester_id) REFERENCES users(user_id)  ON DELETE CASCADE,
  FOREIGN KEY (item_id)      REFERENCES items(item_id)  ON DELETE SET NULL
);

-- ── NOTIFICATIONS (new — 3NF bonus table) 
CREATE TABLE notifications (
  notif_id      INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  user_id       INT NOT NULL,                      -- FK → users
  message       VARCHAR(500) NOT NULL,
  is_read       TINYINT(1) DEFAULT 0,
  created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ── ITEM STATUS LOG (audit trail)
CREATE TABLE item_status_log (
  log_id        INT AUTO_INCREMENT PRIMARY KEY,    -- PK
  item_id       INT NOT NULL,                      -- FK → items
  old_status    VARCHAR(20),
  new_status    VARCHAR(20),
  changed_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (item_id) REFERENCES items(item_id) ON DELETE CASCADE
);


--  AI Matches Table

CREATE TABLE IF NOT EXISTS ai_matches (
  match_id          INT AUTO_INCREMENT PRIMARY KEY,
  lost_item_id      INT NOT NULL,
  found_item_id     INT NOT NULL,
  confidence_score  TINYINT UNSIGNED NOT NULL DEFAULT 0,  -- 0–100
  match_reason      VARCHAR(400),
  status ENUM('pending','confirmed','dismissed') DEFAULT 'pending',
  created_at        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at        TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  -- Prevent duplicate pairs
  UNIQUE KEY uq_pair (lost_item_id, found_item_id),
  FOREIGN KEY (lost_item_id)  REFERENCES items(item_id) ON DELETE CASCADE,
  FOREIGN KEY (found_item_id) REFERENCES items(item_id) ON DELETE CASCADE
);

CREATE INDEX idx_ai_matches_score ON ai_matches(confidence_score DESC);



