  UPDATE items
    SET status = 'matched'
  WHERE item_id = 1 AND status = 'active';

  UPDATE items
    SET status = 'matched'
  WHERE item_id = 2 AND status = 'active';

  INSERT INTO item_status_log (item_id, old_status, new_status)
    VALUES (1, 'active', 'matched'),
           (2, 'active', 'matched');
COMMIT;


--  SECTION 8 HAVING
 
-- 8a. active users
SELECT full_name, role,
  (SELECT COUNT(*) FROM items WHERE items.user_id = users.user_id) AS reports_count
FROM users
HAVING reports_count > 1
ORDER BY reports_count DESC;
 
-- 8c. 
SELECT
  location,
  COUNT(*) AS lost_here
FROM items
WHERE type = 'lost'
GROUP BY location
HAVING lost_here >= 1
ORDER BY lost_here DESC;
 

-- 9. SUBQUERIES (2) 

-- SUBQUERY 1: No item reported

SELECT
  user_id,
  full_name,
  email,
  role
FROM users
WHERE user_id NOT IN (
  SELECT DISTINCT user_id FROM items WHERE user_id IS NOT NULL
);

-- SUBQUERY 2: Items that have received AT LEAST ONE comment
SELECT
  i.item_id,
  i.title,
  i.type,
  i.location,
  (SELECT COUNT(*) FROM comments c WHERE c.item_id = i.item_id) AS comment_count
FROM items i
WHERE i.item_id IN (
  SELECT DISTINCT item_id FROM comments
)
ORDER BY comment_count DESC;



