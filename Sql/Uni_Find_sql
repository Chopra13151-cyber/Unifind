-- 5. JOINS

-- JOIN 1: INNER JOIN
SELECT
  i.item_id,
  i.title,
  i.type,
  i.status,
  i.location,
  u.full_name   AS reported_by,
  c.name        AS category_name,
  i.reported_at
FROM items i
INNER JOIN users      u ON i.user_id     = u.user_id
LEFT JOIN  categories c ON i.category_id = c.category_id
ORDER BY i.reported_at DESC;

-- JOIN 2: LEFT JOIN
SELECT
  u.user_id,
  u.full_name,
  u.role,
  COUNT(i.item_id) AS total_reports
FROM users u
LEFT JOIN items i ON i.user_id = u.user_id
GROUP BY u.user_id, u.full_name, u.role
ORDER BY total_reports DESC;


-- 6. GROUP BY 
-- a. Item stats per category
SELECT
  c.name              AS category,
  COUNT(i.item_id)    AS total_items,
  SUM(i.type = 'lost')    AS lost_count,
  SUM(i.type = 'found')   AS found_count,
  SUM(i.status = 'matched')   AS matched_count
FROM categories c
LEFT JOIN items i ON i.category_id = c.category_id
GROUP BY c.category_id, c.name
ORDER BY total_items DESC;


-- b.
SELECT
  status,
  COUNT(*) AS total_requests
FROM cctv_requests
GROUP BY status
ORDER BY total_requests DESC;


-- 6c. STORED PROCEDURE — resolve_match(lostId, foundId)

DROP PROCEDURE IF EXISTS resolve_match;

DELIMITER $$

CREATE PROCEDURE resolve_match(
  IN p_lost_id  INT,
  IN p_found_id INT
)
BEGIN
  DECLARE v_lost_owner  INT;
  DECLARE v_found_owner INT;

  -- Fetch owners
  SELECT user_id INTO v_lost_owner  FROM items WHERE item_id = p_lost_id;
  SELECT user_id INTO v_found_owner FROM items WHERE item_id = p_found_id;

  START TRANSACTION;

    -- Update both items to resolved
    UPDATE items SET status = 'resolved' WHERE item_id = p_lost_id;
    UPDATE items SET status = 'resolved' WHERE item_id = p_found_id;

    INSERT INTO item_status_log (item_id, old_status, new_status)
      VALUES (p_lost_id,  'matched', 'resolved'),
             (p_found_id, 'matched', 'resolved');

    -- Notify both owners
    INSERT INTO notifications (user_id, message) VALUES
      (v_lost_owner,
       CONCAT('Great news! Your lost item (ID:', p_lost_id, ') has been resolved.')),
      (v_found_owner,
       CONCAT('Thank you! The item you found (ID:', p_found_id, ') has been claimed.'));

  COMMIT;

END$$

DELIMITER ;

